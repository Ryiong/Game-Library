<Window x:Class="Game_Library.AddGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Game_Library"
        xmlns:ext="clr-namespace:Game_Library.Extensions"
        FontFamily="pack://application:,,,/Resources/Fonts/#SF Pro Display"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        ResizeMode="NoResize"
        Title="AddGameWindow" Height="600" Width="960">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="25"
                  UseAeroCaptionButtons="False"
                  GlassFrameThickness="0"
                  CornerRadius="14"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ext:ThumbnailConverter x:Key="ThumbnailConverter"/>
    </Window.Resources>
    <Border Background="#F5F5F7" CornerRadius="14" BorderBrush="#D2D2D7" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Header -->
            <Border Grid.Row="0" Background="#F0FCF8" BorderBrush="#ffffff" CornerRadius="14,14,0,0" BorderThickness="0,0,0,0" Panel.ZIndex="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" Direction="0" ShadowDepth="2" Opacity="0.14" Color="Black"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource MacTrafficLightButtonStyle}" Background="#FF5F56" ext:ButtonProps.HoverBackground="#F74339" ext:ButtonProps.PressedBackground="#DB332a" BorderThickness="1.5" BorderBrush="#cc4f46" Click="CloseButton_Click" Foreground="#E0443E">
                        <Control Template="{StaticResource IconQuit}" BorderThickness="2" Width="6" Height="6" Foreground="#7b0708"/>
                    </Button>
                    <Button Style="{StaticResource MacTrafficLightButtonStyle}" Background="#FAC146" ext:ButtonProps.HoverBackground="#F5B11D" ext:ButtonProps.PressedBackground="#F2A807" BorderThickness="1.5" BorderBrush="#d4a338" Click="MinimizeButton_Click">
                        <Control Template="{StaticResource IconMinimize}" BorderThickness="2" Width="8" Height="8" Foreground="#9c5512" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource MacTrafficLightButtonStyle}" Margin="0" Background="#27C93F" ext:ButtonProps.HoverBackground="#13D630" ext:ButtonProps.PressedBackground="#04C921" BorderThickness="1.5" BorderBrush="#369841" Click="MaximizeButton_Click">
                        <Control Template="{StaticResource IconMaximize}" BorderThickness="2" Width="8" Height="8" Foreground="#0d660f"/>
                    </Button>
                </StackPanel>
            </Border>
            <TextBlock x:Name="txtWindowTitle" Grid.Row="0" Text="{Binding WindowTitle}" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="20" FontSize="13" FontWeight="Bold" Foreground="#046B59"/>
            <!-- Content -->
            <Border Grid.Row="1" CornerRadius="0,0,14,14" Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Input layout -->
                    <ScrollViewer Grid.Column="0" Padding="0,20,15,0" VerticalScrollBarVisibility="Disabled" Margin="0,0,6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!--Title -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên Game" Style="{StaticResource InputHeaderLabelStyle}" Margin="0,12,15,12"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtTitle" Text="{Binding Title, Mode=TwoWay}" Style="{StaticResource RoundedTextBoxStyle}" Margin="0,6,5,6" FontSize="13"/>

                            <!-- Type -->
                            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,5,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Type" Style="{StaticResource InputHeaderLabelStyle}" Margin="0,0,15,0"/>
                                <ComboBox Grid.Column="1" x:Name="cbType" SelectedValue="{Binding SelectedType, Mode=TwoWay}" SelectedValuePath="Content" Style="{StaticResource RoundedComboBoxStyle}" Width="100" Height="34" Margin="0,6" Background="#F2F2F7" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="FLASH" FontFamily="pack://application:,,,/Resources/Fonts/#SF Pro Text"/>
                                    <ComboBoxItem Content="HTML5" FontFamily="pack://application:,,,/Resources/Fonts/#SF Pro Text"/>
                                    <ComboBoxItem Content="EXE" FontFamily="pack://application:,,,/Resources/Fonts/#SF Pro Text"/>
                                </ComboBox>
                                <TextBlock Grid.Column="2" Text="NSFW" Style="{StaticResource InputHeaderLabelStyle}" Margin="0,0,15,0"/>
                                <ToggleButton Grid.Column="3" x:Name="tgNsfw" Style="{StaticResource ModernToggleSwitchStyle}" IsChecked="{Binding IsNsfw, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="0,6"/>
                            </Grid>

                            <!-- Description -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Mô tả" Style="{StaticResource InputHeaderLabelStyle}" VerticalAlignment="Top" Margin="0,12,15,0"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtDescription" Text="{Binding Description, Mode=TwoWay}" Style="{StaticResource RoundedTextBoxStyle}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,6,5,6"/>

                            <!-- Date -->
                            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,5,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Ngày thêm vào" Style="{StaticResource InputHeaderLabelStyle}"/>
                                <DatePicker Grid.Column="1" x:Name="dpAddedDate" Style="{StaticResource MordemDatePicker}"
                                            SelectedDate="{Binding AddedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32"/>

                                <TextBlock Grid.Column="2" Text="Ngày ra mắt" Style="{StaticResource InputHeaderLabelStyle}"/>
                                <DatePicker Grid.Column="3" x:Name="dpReleaseDate" Style="{StaticResource MordemDatePicker}"
                                            SelectedDate="{Binding ReleaseDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                            </Grid>

                            <!-- Thumbnail -->
                            <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,5,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="99"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Ảnh bìa" Style="{StaticResource InputHeaderLabelStyle}" VerticalAlignment="Top" Margin="0,10,15,0" Height="16" Width="43"/>
                                <Button x:Name="SelectThumbnail" Grid.Column="1" Width="80" Height="80" HorizontalAlignment="Left" Background="#F8FAF9" BorderBrush="#046B59" BorderThickness="1.5" Cursor="Hand" Command="{Binding SelectThumbnailCommand}">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="+" FontSize="22" Foreground="#046B59" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Select Image" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#046B59" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <TextBlock Grid.Column="2" Text="Import Folder / File" Style="{StaticResource InputHeaderLabelStyle}" VerticalAlignment="Top" Margin="0,0,10,0" Height="35" Width="88" TextWrapping="Wrap"/>
                                <StackPanel Grid.Column="3" Orientation="Vertical" VerticalAlignment="Top">
                                    <Button x:Name="SelectFolder" Content="Chọn Folder game" Height="30" Style="{StaticResource MacPrimaryButtonStyle}" Margin="0,0,0,6" Command="{Binding SelectFolderCommand}"/>
                                    <Button x:Name="SelectSingleFile" Content="Chọn File game" Height="30" Style="{StaticResource MacPrimaryButtonStyle}" Command="{Binding SelectSingleFileCommand}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Image in Game -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Ảnh Ingame" Style="{StaticResource InputHeaderLabelStyle}" VerticalAlignment="Top" Margin="0,15,15,0"/>
                            <Grid Grid.Row="5" Grid.Column="1" Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <WrapPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button x:Name="SelectImageInGame" Width="80" Height="80" Background="#F8FAF9" BorderBrush="#046B59" BorderThickness="1.5" Margin="0,0,8,8" Cursor="Hand" Command="{Binding SelectInGameImagesCommand}">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                        <StackPanel>
                                            <TextBlock Text="+" FontSize="20" Foreground="#046B59" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Select Image" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#046B59" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="* Tối đa 6 hình ảnh chụp trong game." FontSize="11" Foreground="#888888" Margin="0,2,3,0"/>
                            </Grid>
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Game liên quan" Style="{StaticResource InputHeaderLabelStyle}" Margin="0,12,15,12"/>
                            <ComboBox Grid.Row="6" Grid.Column="1" x:Name="cbRelatedGame" Style="{StaticResource ModernCheckComboBoxStyle}" ItemsSource="{Binding RelatedGames}" Text="-- Chọn game liên quan --" Height="34" Margin="0,6,5,6" Background="#F2F2F7" HorizontalAlignment="Stretch" DisplayMemberPath="Title" SelectedValuePath="Id"/>
                            <Button Grid.Row="7" Width="70" VerticalAlignment="Top" x:Name="SaveButton" Grid.Column="1" Height="34" Style="{StaticResource MacPrimaryButtonStyle}" Command="{Binding SaveCommand}" Margin="139,10,139,0" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                                    Content="{Binding SaveButtonContent}"/>
                        </Grid>
                    </ScrollViewer>


                    <Border Grid.Column="0" HorizontalAlignment="Right" Width="1" Background="#E6F2ED" VerticalAlignment="Stretch" Margin="0,0,5,0"/>

                    <!--Preview data final Layout-->
                    <Grid Grid.Column="1" Margin="15,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Final Information View" FontSize="16" FontWeight="Bold" Foreground="#046B59" HorizontalAlignment="Center" Margin="0,15"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Title" Style="{StaticResource InputHeaderLabelStyle}" Foreground="#131E1B"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=txtTitle, Path=Text}" Style="{StaticResource PreviewDataTextStyle}"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Type" Style="{StaticResource InputHeaderLabelStyle}" Foreground="#131E1B"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=cbType, Path=SelectedItem.Content}" Style="{StaticResource PreviewDataTextStyle}"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="NSFW" Style="{StaticResource InputHeaderLabelStyle}" Foreground="#131E1B"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=tgNsfw, Path=IsChecked}" Style="{StaticResource PreviewDataTextStyle}" FontWeight="Bold" Foreground="#E0443E"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Description" Style="{StaticResource InputHeaderLabelStyle}" Foreground="#131E1B"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=txtDescription, Path=Text}" Style="{StaticResource PreviewDataTextStyle}" TextWrapping="Wrap"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Series" Style="{StaticResource InputHeaderLabelStyle}" Foreground="#131E1B"/>
                                    <ItemsControl Grid.Column="1" x:Name="icPreviewRelatedGames">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid x:Name="itemRoot" Visibility="Collapsed">
                                                    <TextBlock Text="{Binding Title}" 
                                                        Style="{StaticResource PreviewDataTextStyle}" 
                                                        Margin="0,2" 
                                                        Foreground="#046B59" 
                                                        FontWeight="Medium"/>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="itemRoot" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="AddedDate" Style="{StaticResource InputHeaderLabelStyle}" Foreground="#131E1B"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=dpAddedDate, Path=Text}" Style="{StaticResource PreviewDataTextStyle}"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ReleaseDate" Style="{StaticResource InputHeaderLabelStyle}" Foreground="#131E1B"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=dpReleaseDate, Path=Text}" Style="{StaticResource PreviewDataTextStyle}"/>
                                </Grid>

                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Thumbnail" Style="{StaticResource InputHeaderLabelStyle}" Foreground="#131E1B"/>
                                    <Grid Grid.Column="1" HorizontalAlignment="Left">
                                        <Border HorizontalAlignment="Left" Width="120" Height="80" CornerRadius="8" ClipToBounds="True" Background="#EDF2F0">
                                            <Image x:Name="imgPreviewThumbnail" 
                                                    Stretch="UniformToFill"
                                                    Source="{Binding ThumbnailSource}"/>
                                        </Border>
                                        <Button Command="{Binding RemoveThumbnailCommand}"
                                                Style="{StaticResource NonableButtonStyle}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,-5,-5,0" 
                                                Cursor="Hand" Background="Transparent">
                                            <Button.Content>
                                                <Control Template="{StaticResource IconClose}" Width="20" Height="20" Foreground="#046B59"/>
                                            </Button.Content>
                                        </Button>
                                    </Grid>
                                </Grid>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ImageInGame" Style="{StaticResource InputHeaderLabelStyle}" Foreground="#131E1B" VerticalAlignment="Top"/>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding SelectedInGameImages}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Width="120" Height="80" Margin="0,0,10,10">
                                                    <Grid>
                                                        <MediaElement x:Name="gifPreviewPlayer"
                                                                    Source="{Binding Converter={StaticResource ThumbnailConverter}, ConverterParameter=AsUri}"
                                                                    LoadedBehavior="Play"
                                                                    UnloadedBehavior="Manual"
                                                                    MediaEnded="GifPreviewPlayer_MediaEnded"
                                                                    IsMuted="True"
                                                                    Stretch="UniformToFill"
                                                                    Visibility="Collapsed"/>
                                                        <Image x:Name="staticPreviewImage"
                                                               Source="{Binding Converter={StaticResource ThumbnailConverter}}"
                                                               Stretch="UniformToFill"
                                                               Visibility="Visible"/>
                                                    </Grid>
                                                    <Button Command="{Binding DataContext.RemoveInGameImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource NonableButtonStyle}"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="0,-5,-5,0"
                                                            Cursor="Hand" Background="Transparent">
                                                        <Button.Content>
                                                            <Control Template="{StaticResource IconClose}" Width="20" Height="20" Foreground="#046B59"/>
                                                        </Button.Content>
                                                    </Button>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Converter={StaticResource ThumbnailConverter}, ConverterParameter=IsGif}" Value="True">
                                                        <Setter TargetName="gifPreviewPlayer" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="staticPreviewImage" Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Folder Structure" FontWeight="Bold" Foreground="#131E1B" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="txtPreviewFolderName" Text="FolderName (Root)" FontWeight="Bold" Foreground="#576865" Margin="0,0,0,4"/>
                                        <TreeView x:Name="trvFolderStructure" ItemsSource="{Binding FolderTreeItems}" BorderThickness="0" Background="Transparent" Padding="0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
