<Window x:Class="Game_Library.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ext="clr-namespace:Game_Library.Extensions"
        xmlns:local="clr-namespace:Game_Library"
        mc:Ignorable="d" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" Title="Password Verification" Height="150" Width="340">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="25"
              UseAeroCaptionButtons="False"
              GlassFrameThickness="0"
              CornerRadius="14"/>
    </WindowChrome.WindowChrome>
    <Border Background="#F5F5F7" CornerRadius="12" BorderBrush="#D2D2D7" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Header -->
            <Border Grid.Row="0" Background="#F0FCF8" BorderBrush="#ffffff" CornerRadius="14,14,0,0" BorderThickness="0,0,0,0" Panel.ZIndex="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" Direction="0" ShadowDepth="2" Opacity="0.14" Color="Black"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource MacTrafficLightButtonStyle}" Background="#FF5F56" ext:ButtonProps.HoverBackground="#F74339" ext:ButtonProps.PressedBackground="#DB332a" BorderThickness="1.5" BorderBrush="#cc4f46" Click="CloseButton_Click" Foreground="#E0443E">
                        <Control Template="{StaticResource IconQuit}" BorderThickness="2" Width="6" Height="6" Foreground="#7b0708"/>
                    </Button>
                    <Button Style="{StaticResource MacTrafficLightButtonStyle}" Background="#FAC146" ext:ButtonProps.HoverBackground="#F5B11D" ext:ButtonProps.PressedBackground="#F2A807" BorderThickness="1.5" BorderBrush="#d4a338" Click="MinimizeButton_Click">
                        <Control Template="{StaticResource IconMinimize}" BorderThickness="2" Width="8" Height="8" Foreground="#9c5512" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource MacTrafficLightButtonStyle}" Margin="0" Background="#27C93F" ext:ButtonProps.HoverBackground="#13D630" ext:ButtonProps.PressedBackground="#04C921" BorderThickness="1.5" BorderBrush="#369841" Click="MaximizeButton_Click">
                        <Control Template="{StaticResource IconMaximize}" BorderThickness="2" Width="8" Height="8" Foreground="#0d660f"/>
                    </Button>
                </StackPanel>
            </Border>
            <TextBlock Grid.Row="0" Text="Password" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="20" FontSize="12" FontWeight="Bold" Foreground="#046B59" Margin="0,5"/>
            <PasswordBox Grid.Row="1" x:Name="txtPassword" Height="34" Width="250" VerticalContentAlignment="Center" Padding="8,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <PasswordBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </PasswordBox.Resources>
            </PasswordBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                <Button Content="Hủy" Width="70" Height="30" Margin="0,0,10,0" Click="Cancel_Click" Style="{StaticResource NonableButtonStyle}" Foreground="#888888"/>
                <Button Content="Xác nhận" Width="85" Height="30" FontWeight="Bold" Click="Confirm_Click" Style="{StaticResource MacPrimaryButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
