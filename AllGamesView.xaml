<UserControl x:Class="Game_Library.AllGamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Game_Library"
             FontFamily="./Resources/Fonts/#SF Pro Display"
             mc:Ignorable="d"  Background="White">
    <UserControl.Resources>
        <local:ThumbnailConverter x:Key="ThumbConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel Margin="10,0">
            <StackPanel Margin="0,10,0,0" x:Name="RecentSection">
                <TextBlock Text="Recently Played" Foreground="#131E1B" FontSize="26" FontWeight="Bold" Margin="0,0,0,15"/>
                <Border  Width="332" Height="290" HorizontalAlignment="Left" CornerRadius="24" Margin="0,0,0,35">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Thumbnail, Converter={StaticResource ThumbConverter}}" Stretch="UniformToFill"/>
                    </Border.Background>
                    <Border Background="#59000000" CornerRadius="24">
                        <Grid>
                            <StackPanel Width="317" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="15,0,0,0">
                                <Border Background="#005B41" CornerRadius="10" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Type}" Foreground="White" FontSize="12" FontWeight="Medium"/>
                                </Border>
                                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="25" FontWeight="Heavy" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding LastPlayedText}" Foreground="White" FontSize="15" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                <Button x:Name="PlayAgainBtn" Width="110" HorizontalAlignment="Left" Margin="0,20,0,35" Background="#19FFFFFF" BorderBrush="#33FFFFFF" Padding="5, 10" Click="PlayAgainBtn_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="btnBorder" Background="#19FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Padding="5,10">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="btnBorder" Property="Background" Value="#33FFFFFF"/>
                                                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#65FFFFFF"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="btnBorder" Property="Background" Value="#66FFFFFF"/>
                                                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#88FFFFFF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Control Template="{StaticResource IconPlay}" Width="20" Height="20" Foreground="White"/>
                                        <TextBlock Text="Play Again" VerticalAlignment="Center" Foreground="White" Margin="10,0,0,0" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>
            </StackPanel>

            <TextBlock Text="All Games" Foreground="#131E1B" FontSize="26" FontWeight="Bold" Margin="0,0,0,15"/>
            <ItemsControl x:Name="AllGamesLayout">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="10,10" Width="180">
                            <Border Height="140" CornerRadius="16" ClipToBounds="True">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Thumbnail, Converter={StaticResource ThumbConverter}}" Stretch="UniformToFill"/>
                                </Border.Background>
                                <Grid>
                                    <Border Background="White" CornerRadius="5" Padding="6,3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                        <TextBlock Text="{Binding Type}" Foreground="#005B41" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Title}" Foreground="#131E1B" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,3" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding AddedDate}" Foreground="#888888" FontSize="10"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
