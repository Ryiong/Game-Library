<UserControl x:Class="Game_Library.Views.CollectionDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Game_Library.Views"
             xmlns:ext="clr-namespace:Game_Library.Extensions"
             FontFamily="pack://application:,,,/Resources/Fonts/#SF Pro Display"
             Background="White">
    <UserControl.Resources>
        <ext:ThumbnailConverter x:Key="ThumbConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,15">

            <!-- Collection Header Info -->
            <Grid Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Cover Thumbnail -->
                <Border Grid.Column="0" Height="140" CornerRadius="12" ClipToBounds="True" Background="#EDF2F0">
                    <Image Source="{Binding CurrentCollection.Thumbnail, Converter={StaticResource ThumbConverter}}" Stretch="UniformToFill"/>
                </Border>

                <!-- Title & Action Buttons -->
                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentCollection.Title}" FontSize="24" FontWeight="Bold" Foreground="#131E1B" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding CollectionGames.Count, StringFormat='Tổng số: {0} trò chơi'}" FontSize="12" Foreground="#046B59" FontWeight="SemiBold" Margin="0,0,0,15"/>

                    <Button Command="{Binding EditCollectionCommand}" Style="{StaticResource MacPrimaryButtonStyle}" HorizontalAlignment="Left" Width="140" Height="32">
                        <StackPanel Orientation="Horizontal">
                            <Control Template="{StaticResource IconEdit}" Width="16" Height="16" Foreground="#046B59"/>
                            <TextBlock Text="Edit Collection" Margin="6,0,0,0" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border BorderBrush="#E6F2ED" BorderThickness="0,1,0,0" Margin="0,0,0,15" Padding="0,10,0,0">
                <TextBlock Text="GAMES IN COLLECTION" FontSize="16" FontWeight="Bold" Foreground="#046B59"/>
            </Border>

            <!-- Games Cards List -->
            <ListView ItemsSource="{Binding CollectionGames}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" IsItemsHost="True"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CardGameButtonStyle}" Command="{Binding DataContext.OpenGameDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,18,20" Width="175" Cursor="Hand">
                            <StackPanel>
                                <Border Height="130" CornerRadius="16" ClipToBounds="True" Width="175">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Thumbnail, Converter={StaticResource ThumbConverter}}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                    <Border Background="White" CornerRadius="5" Padding="6,3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                        <TextBlock Text="{Binding Type}" Foreground="#005B41" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                </Border>
                                <TextBlock Text="{Binding Title}" Foreground="#005B41" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,2" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</UserControl>
