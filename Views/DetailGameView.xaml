<UserControl x:Class="Game_Library.Views.DetailGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ext="clr-namespace:Game_Library.Extensions"
             FontFamily="pack://application:,,,/Resources/Fonts/#SF Pro Display"
             Background="White">
    <UserControl.Resources>
        <ext:ThumbnailConverter x:Key="ThumbConverter"/>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Khung thông tin chi tiết game -->
        <Grid Grid.Row="0" Margin="0,10,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Slideshow -->
            <Border Grid.Column="0" Width="425" Height="281" ClipToBounds="True" Background="#EDF2F0">
                <Grid>
                    <Canvas x:Name="SlideshowCanvas" Width="425" Height="281">
                        <StackPanel x:Name="SlideContainerStackPanel" Orientation="Horizontal" Canvas.Left="0">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="SlideshowTranslate"/>
                            </StackPanel.RenderTransform>
                            <ItemsControl x:Name="icSlideshowImages">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Converter={StaticResource ThumbConverter}}" Width="425" Height="281" Stretch="UniformToFill"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Canvas>

                    <Button Style="{StaticResource NonableButtonStyle}" Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" Click="PrevSlide_Click" Cursor="Hand">
                        <Control Template="{StaticResource IconLeft}" Width="24" Height="24" VerticalAlignment="Center" Foreground="#046B59"/>
                    </Button>

                    <Button Style="{StaticResource NonableButtonStyle}" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" Click="NextSlide_Click" Cursor="Hand">
                        <Control Template="{StaticResource IconRight}" Width="24" Height="24" VerticalAlignment="Center" Foreground="#046B59"/>
                    </Button>
                    <StackPanel x:Name="DotsContainer" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,15"/>
                </Grid>
            </Border>

            <!-- Metadata -->
            <Grid Grid.Column="1" Margin="20,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding Title}" Foreground="#131E1B" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Type: " Foreground="#777777" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding Type}" Foreground="#046B59" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" Foreground="#555555" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,15" ext:TextBlockExtensions.MaxLines="4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Added Date: " Foreground="#777777" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding AddedDate}" Foreground="#131E1B" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Release Date: " Foreground="#777777" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding ReleaseDate}" Foreground="#131E1B" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,20,0,0">
                    <Button x:Name="PlayButton" Style="{StaticResource MacPrimaryButtonStyle}" Width="130" Height="30" Background="#EDF2F0" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand" Click="PlayNow_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="16"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <Control Template="{StaticResource IconPlay}" Width="16" Height="16" Foreground="#046B59" VerticalAlignment="Center"/>
                            <TextBlock Text="PLAY NOW!" Foreground="#046B59" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="FavButton" Style="{StaticResource MacPrimaryButtonStyle}" Width="130" Height="30" Background="#EDF2F0" BorderThickness="0" Cursor="Hand" Click="Favorite_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="16"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <Control x:Name="HeartIcon" Template="{StaticResource IconHeart}" Width="16" Height="16" Foreground="#046B59" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FavText" Text="FAVARITE" Foreground="#046B59" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Game Series liên quan -->
        <TextBlock Grid.Row="1" Text="RELATED GAMES" Foreground="#046B59" HorizontalAlignment="Center" FontSize="18" FontWeight="Bold" Margin="0,10,0,15"/>
        <ItemsControl x:Name="icRelatedGamesGrid" Grid.Row="2">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,20,20" Width="150">
                        <Border Height="110" CornerRadius="12" ClipToBounds="True">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Thumbnail, Converter={StaticResource ThumbConverter}}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="{Binding Title}" Foreground="#131E1B" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,2" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>